# @slopstream/api — Lane 2 (Money & Marketplace)
# Copy to .env and fill in. Never commit the real .env.

# HTTP command + snapshot API
PORT=4000

# Postgres ledger (brands, bids, segments, attention_events, reward_pools, ...)
DATABASE_URL=postgres://slopstream:slopstream@localhost:5432/slopstream

# Redis — API publishes persisted marketplace events; orchestrator subscribes.
REDIS_URL=redis://localhost:6379

# Stripe — the only fiat rail. Use test-mode keys for the hackathon.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_BASE_URL=http://localhost:3000

# Lane 1 proof verifier. Until the real Compact contracts land this points at
# the JSON-stub verifier service (apps/verifier). The URL is the verify
# endpoint itself; POSTed the shared AttentionProofVerificationRequest.
PROOF_VERIFIER_URL=http://localhost:4100/v1/attention-proofs/verify
PROOF_VERIFIER_MODE=stub
# Shared bearer token used only for API → verifier service calls in remote mode.
PROOF_VERIFIER_TOKEN=

# Reward split defaults (per-pool overrides live in the ledger).
DEFAULT_LISTENER_PERCENTAGE=0.8
DEFAULT_PLATFORM_PERCENTAGE=0.2

# Auction + attention-window tuning (hackathon defaults shown).
AUCTION_DURATION_SEC=60
THRESHOLD_FRACTION=0.6
WINDOW_GRACE_SEC=3

# Seed the three demo brands with funded balances (set to 0 to disable).
SEED_DEMO=1

# Hackathon-only browser credential for the seeded ACME AI console. This is
# deliberately public in the local demo profile; never set it in production.
DEMO_ACME_BRAND_TOKEN=slopstream-demo-acme-token

# Shared service credential for Lane 3 lifecycle mutations. Use a secret value
# outside local development and configure the same value in the orchestrator.
ORCHESTRATOR_API_TOKEN=slopstream-demo-orchestrator-token

# Bearer token required to create a brand via POST /brands. Use a secret
# value in production; the frontend sends it from a server-side route.
BRAND_CREATOR_TOKEN=slopstream-demo-brand-creator-token

# Sessions without authenticated activity in this interval stop counting toward
# the frozen attention denominator and public listener stats.
ACTIVE_LISTENER_WINDOW_SEC=120

# Set to 0 when the Lane 3 orchestrator is the sole emitter of lifecycle events
# (segment.generating, generation.progress, segment.ready, segment.playing,
# challenge.fired). Leave unset (or 1) when the orchestrator is NOT running and
# the API is the event source. Failing to set this when both run causes
# duplicate WebSocket events.
PUBLISH_LIFECYCLE_EVENTS=0
