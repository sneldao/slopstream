# @slopstream/orchestrator — Lane 3 (Stream & Experience)
# Copy to .env and fill in. Never commit the real .env.

# WebSocket gateway that every screen connects to after loading its snapshot.
PORT=4200

# Redis — subscribes to Lane 2's marketplace events (bid.*, attention.verified,
# reward.*, stats.*, leaderboard.*) and publishes its own runtime events
# (segment.*, generation.progress, challenge.fired).
REDIS_URL=redis://localhost:6379

# Lane 2 API — the orchestrator consumes auction results and snapshots; it
# never resolves auctions or settles money itself.
API_BASE_URL=http://localhost:4000

# Lane 1 generator — source of asset URL + transcript + metadata per segment.
GENERATOR_BASE_URL=http://localhost:4300

# Drive the whole UI from a committed fixture instead of live services
# (the on-stage insurance policy). See DemoFixture in @slopstream/shared.
DEMO_MODE=false
DEMO_FIXTURE_ID=hackathon-main
