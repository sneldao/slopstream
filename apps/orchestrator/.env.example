# @slopstream/orchestrator — Lane 3 (Stream & Experience)
# Copy to .env and fill in. Never commit the real .env.
# All values below are the defaults — the orchestrator runs with no .env.

# HTTP + WebSocket gateway that every screen connects to after loading its
# REST snapshot. Also reverse-proxies every other REST call to the Lane 2
# API, so browsers only ever talk to this port.
PORT=4200

# Lane 2 API — the orchestrator consumes auction results, snapshots, and the
# marketplace event stream (GET /events); it never resolves auctions or
# settles money itself. Run the API with PUBLISH_LIFECYCLE_EVENTS=0 so this
# service is the sole emitter of segment.* / generation.progress /
# challenge.fired events.
API_BASE_URL=http://localhost:4000

# Lane 1 generator — source of asset URL + transcript + metadata per segment.
GENERATOR_BASE_URL=http://localhost:4300

# Shared service credentials. Use secret values outside local development and
# configure the same values in apps/api and apps/generator respectively.
ORCHESTRATOR_API_TOKEN=slopstream-demo-orchestrator-token
GENERATOR_API_TOKEN=slopstream-demo-generator-token

# Compressed playback length (seconds). Sent to /ready and /challenge-source
# as durationSec and is the real elapsed time before /window-closed — all
# three must agree because the verifier enforces challenge windows in
# wall-clock time.
SEGMENT_PLAY_SEC=20

# How often to poll GET /auctions/current for closed slots (ms).
AUCTION_POLL_MS=2000

# How often to poll GET /events?after=N for marketplace deliveries (ms).
EVENTS_POLL_MS=750

# Delay between generation.progress stage beats (ms).
GEN_STAGE_DELAY_MS=700

# --- Cold-start scraper (docs/product/content.md) ---------------------------
# Parallel.ai Search API key (https://docs.parallel.ai). When set, the
# orchestrator periodically searches for newly launched companies (Show HN,
# Product Hunt, YC, startup press) and ingests them into the API's free-ad
# queue; the auction engine turns them into free filler segments whenever a
# slot closes with no bids. Leave empty to disable the scraper.
PARALLEL_API_KEY=

# How often to run a discovery pass (ms). Default 30 minutes.
SCRAPER_POLL_MS=1800000

# Max results per Parallel Search call.
SCRAPER_MAX_RESULTS=10

# Optional operational webhook for at-risk generation and sustained dead-air
# alerts. Leave empty to log locally without external dispatch.
ALERT_WEBHOOK_URL=

# Alert sampling, single-request timeout, and sustained-idle threshold
# (milliseconds). Failed webhook deliveries are retried on the next sample.
ALERT_POLL_MS=5000
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_IDLE_THRESHOLD_MS=10000
