# @slopstream/web — Lane 3 (big screen, listener client, brand console)
# Copy to .env.local and fill in. Never commit the real env file.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

# Lane 2 HTTP command + snapshot API (bids, top-ups, sessions, proofs,
# GET /stream/snapshot). NEXT_PUBLIC_API_URL is accepted temporarily as a
# legacy alias; use this documented name for new configuration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Demo-only credential for the API's seeded ACME AI brand. It is intentionally
# browser-visible in the local hackathon profile; never use it in production.
NEXT_PUBLIC_DEMO_BRAND_TOKEN=slopstream-demo-acme-token

# `demo` uses the fixture with no services. `live` enables the REST client.
NEXT_PUBLIC_STREAM_MODE=demo

# Lane 3 WebSocket gateway — server-to-client projection of live state.
NEXT_PUBLIC_WS_URL=ws://localhost:4200

# Public base URL encoded into the listener QR code on the big screen.
NEXT_PUBLIC_LISTENER_URL=http://localhost:3000/listen
