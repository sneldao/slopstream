# @slopstream/web — Lane 3 (big screen, listener client, brand console)
# Copy to .env.local and fill in. Never commit the real env file.
# NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

# Lane 2 API (snapshot + commands) and Lane 3 gateway (WebSocket).
# These are BUILD-TIME values baked into the browser bundle: shipping a public
# build with the localhost values below means every visitor's browser dials
# its own machine and the feed reads "Can't reach the live stream" forever.
# Set both to the deployed gateway's public https:// and wss:// origins, or
# leave both unset when one proxy serves /stream/snapshot and /ws from the
# same origin as the page (the client then derives them from the location).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4200
NEXT_PUBLIC_WS_URL=ws://localhost:4200

# Local dev credential for the API's seeded ACME AI brand. Browser-visible
# only for hackathon-style local dev — replace with real brand auth at launch.
NEXT_PUBLIC_DEMO_BRAND_TOKEN=slopstream-demo-acme-token

# Public base URL encoded into the listener QR code on the big screen.
NEXT_PUBLIC_LISTENER_URL=http://localhost:3000/listen

# Set to 1 to show the stream ops HUD on the brand console (polls /ops/metrics).
# NEXT_PUBLIC_OPS_HUD=1

# Public site URL used for canonical links, sitemap, robots.txt and OG
# metadata. Set this to the deployed domain in production. The PWA manifest is
# deliberately excluded: it must stay origin-relative or Chrome discards its
# start_url and shortcuts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Midnight preprod indexer for the public /verify page. The Midnight-hosted
# indexer was decommissioned 2026-10-09; Blockfrost serves it now and requires
# a project token. Create a Midnight Preprod project at https://blockfrost.io.
# This token is browser-visible by design (Blockfrost tokens are meant to ship
# in client URLs) — use a dedicated project for it.
NEXT_PUBLIC_BLOCKFROST_MIDNIGHT_PROJECT_ID=
# Full override (e.g. a self-hosted indexer) wins over the Blockfrost URL:
# NEXT_PUBLIC_MIDNIGHT_INDEXER=
