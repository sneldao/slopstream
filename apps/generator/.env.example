# @slopstream/generator — Lane 1 (Daytona generation pipeline)
# Copy to .env and fill in. Never commit the real .env.

PORT=4300

# Daytona — disposable sandboxes; each generation run gets a fresh, isolated
# environment that is destroyed afterward.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Generation model providers (LLM script -> TTS -> image -> video).
# Fill in whichever providers the pipeline is wired to.
LLM_API_KEY=
TTS_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=

# Where generated assets are uploaded/served from.
ASSET_BASE_URL=http://localhost:4300/assets

# Scraper ingestion sources for the cold-start free-ad engine.
SCRAPER_SOURCES=hacker_news,product_hunt,yc_launch
