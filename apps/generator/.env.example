# @slopstream/generator — Lane 1 (Daytona generation pipeline)
# Copy to .env and fill in. Never commit the real .env.

PORT=4300

# Hackathon-safe default. `stub` returns deterministic metadata and placeholder
# asset URLs; it makes no provider calls. Set `daytona` only after completing
# the Daytona section below.
GENERATOR_MODE=stub

# Shared bearer required from the orchestrator for generation requests.
GENERATOR_API_TOKEN=slopstream-demo-generator-token

# Daytona — each request creates an ephemeral sandbox and waits for deletion.
# The command receives SLOPSTREAM_GENERATION_REQUEST as JSON and must print
# exactly one JSON GenerationResult with an assetUrl already uploaded to durable
# storage. A Daytona sandbox download URL cannot be returned because cleanup
# immediately destroys the sandbox.
#
# Audio-first snapshot contract: build this package in the snapshot, then run
# `node dist/audioCommand.js` from the generator package directory. This command
# accepts tier=audio only; leave stub mode enabled until all values below exist.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
DAYTONA_SNAPSHOT=
DAYTONA_COMMAND_WORKDIR=/workspace/slopstream/apps/generator
DAYTONA_SCRIPT_COMMAND=node dist/audioCommand.js
DAYTONA_CREATE_TIMEOUT_SEC=120
DAYTONA_EXECUTION_TIMEOUT_SEC=300
DAYTONA_SANDBOX_TTL_MINUTES=15

# Non-secret audio configuration. ASSET_UPLOAD_URL is the authenticated Cloudflare
# Worker endpoint that writes to R2 and returns the durable public asset URL.
ASSET_UPLOAD_URL=https://slopstream-asset-uploader.example.workers.dev
ELEVENLABS_VOICE_ID=

# Map command environment variable names to existing Daytona organization Secret
# names. Create these Secrets in Daytona; never put their values in this file.
# The Worker holds the R2 binding, so Daytona needs only an upload bearer token.
DAYTONA_SECRET_MAPPINGS={"ELEVENLABS_API_KEY":"slopstream-elevenlabs","ASSET_UPLOAD_TOKEN":"slopstream-asset-upload-token"}

# Scraper ingestion sources for the cold-start free-ad engine.
SCRAPER_SOURCES=hacker_news,product_hunt,yc_launch
