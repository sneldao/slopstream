{
  "name": "@slopstream/generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "generate:audio": "node dist/audioCommand.js"
  },
  "dependencies": {
    "@daytona/sdk": "0.205.0",
    "@elevenlabs/elevenlabs-js": "2.65.0",
    "@slopstream/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "3.2.7"
  }
}
