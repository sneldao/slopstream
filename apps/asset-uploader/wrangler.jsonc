{
  "name": "slopstream-asset-uploader",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ASSET_BASE_URL": "https://assets.example.com/slopstream"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "slopstream-assets"
    }
  ]
}
