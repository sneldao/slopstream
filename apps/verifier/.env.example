# @slopstream/verifier — Lane 1 JSON-stub proof verifier
# Copy to .env and fill in. Never commit the real .env.
#
# This service is a hackathon-only integration stub. It validates a typed JSON
# payload, binding, challenge timing, and in-memory nonce reuse. It does NOT
# provide cryptographic proof verification and must never authorize a real
# payout or production clearing decision.

PORT=4100
# Supported modes: `stub` (JSON-stub verifier) and `midnight` (records accepted
# proofs on the deployed ProofOfAttention contract). Midnight mode additionally
# requires MIDNIGHT_WALLET_SEED, PROOF_OF_ATTENTION_CONTRACT_ADDRESS, and
# MIDNIGHT_PRIVATE_STATE_PASSWORD (see packages/midnight/.env.example).
VERIFIER_MODE=stub

# Bearer token required on POST /v1/attention-proofs/verify. Leaving it unset
# keeps the endpoint open for zero-config dev. With NODE_ENV=production the
# service refuses to start when this is unset or still the demo fallback
# "slopstream-demo-verifier-token". Set the same value as PROOF_VERIFIER_TOKEN
# in apps/api when remote mode is enabled.
VERIFIER_API_TOKEN=

# Only needed with VERIFIER_MODE=midnight: 64-hex-character wallet seed and the
# deployed ProofOfAttention contract address (run packages/midnight deploy).
# MIDNIGHT_WALLET_SEED=
# PROOF_OF_ATTENTION_CONTRACT_ADDRESS=
# Required in midnight mode — protects the LevelDB private-state store.
# MIDNIGHT_PRIVATE_STATE_PASSWORD=