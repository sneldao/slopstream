# @slopstream/verifier — Lane 1 JSON-stub proof verifier
# Copy to .env and fill in. Never commit the real .env.
#
# This service is a hackathon-only integration stub. It validates a typed JSON
# payload, binding, challenge timing, and in-memory nonce reuse. It does NOT
# provide cryptographic proof verification and must never authorize a real
# payout or production clearing decision.

PORT=4100
# `stub` is the only supported mode today. Setting `midnight` fails at startup
# until a real Midnight verifier is implemented, preventing a misleading label.
VERIFIER_MODE=stub


# Optional bearer token required on POST /v1/attention-proofs/verify. Set the
# same value as PROOF_VERIFIER_TOKEN in apps/api when remote mode is enabled.
VERIFIER_API_TOKEN=