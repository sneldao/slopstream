# @slopstream/midnight — deploy / verifier integration
# Copy to .env and fill in. Never commit the real .env.

# 64-hex-character wallet seed for the deployer/verifier wallet.
# `pnpm deploy` generates one and writes it to .wallet-seed (gitignored);
# the seed is never printed to the console.
MIDNIGHT_WALLET_SEED=

# Contract address produced by `pnpm deploy`.
PROOF_OF_ATTENTION_CONTRACT_ADDRESS=

# REQUIRED: password protecting the LevelDB private-state and signing-key
# stores. There is no default — the stack refuses to start without it.
MIDNIGHT_PRIVATE_STATE_PASSWORD=

# Optional overrides.
# MIDNIGHT_PRIVATE_STATE_STORE=slopstream-attention-private-state
# MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
