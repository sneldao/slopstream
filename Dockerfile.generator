FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

FROM base AS build
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/generator/package.json apps/generator/
RUN pnpm install --frozen-lockfile --filter @slopstream/generator...
COPY packages/shared/ packages/shared/
COPY apps/generator/ apps/generator/
RUN pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/generator build

FROM base AS run
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/apps/generator/package.json ./apps/generator/
COPY --from=build /app/apps/generator/dist ./apps/generator/dist
COPY --from=build /app/apps/generator/node_modules ./apps/generator/node_modules
EXPOSE 4300
CMD ["node", "apps/generator/dist/index.js"]
