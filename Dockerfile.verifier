FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate

FROM base AS build
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/midnight/package.json packages/midnight/
COPY apps/verifier/package.json apps/verifier/
RUN pnpm install --frozen-lockfile --filter @slopstream/verifier...
COPY packages/shared/ packages/shared/
COPY packages/midnight/ packages/midnight/
COPY apps/verifier/ apps/verifier/
RUN pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/midnight build && pnpm --filter @slopstream/verifier build

FROM base AS run
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/midnight/package.json ./packages/midnight/
COPY --from=build /app/packages/midnight/dist ./packages/midnight/dist
COPY --from=build /app/apps/verifier/package.json ./apps/verifier/
COPY --from=build /app/apps/verifier/dist ./apps/verifier/dist
EXPOSE 4100
CMD ["node", "apps/verifier/dist/index.js"]
