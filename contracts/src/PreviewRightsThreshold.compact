// Slopstream PreviewRightsThreshold — Wave 3. A brand proves it crossed a
// spending threshold WITHOUT exposing its exact spend.
//
// Product motivation: brands competing in a live auction don't want rivals
// to see exactly how much they've spent — that reveals strategy and budget.
// But Slopstream gates premium features (custom story integration,
// interactive formats, priority placement) behind a proven spend level.
// This contract lets a brand prove "I've spent enough to qualify" without
// broadcasting the number: the public leaderboard shows qualification,
// never the budget.
//
// Privacy: the brand's cumulative spend commitment lives in private state;
// only the boolean qualified flag and the threshold are public. Spend
// attestations are owner-recorded (backend posts the commitment after
// Stripe-confirmed top-ups); qualification is proven in-circuit against
// the committed spend.

pragma language_version 0.23;

import CompactStandardLibrary;

// Minimum cumulative spend (cents) that unlocks premium preview rights.
export ledger spendThreshold: Uint<64>;

// Whether the brand has proven spend >= threshold. The only public fact
// about the brand's budget.
export ledger qualified: Boolean;

// Commitment to the brand's cumulative spend (private value, public commitment).
export ledger spendCommitment: Bytes<32>;

// Hashed deployer key; authorizes threshold changes + spend attestations.
export ledger owner: Bytes<32>;

// Administrative sequence; binds the owner key to current state.
export ledger sequence: Counter;

constructor() {
  spendThreshold = 10000 as Uint<64>;
  qualified = false;
  spendCommitment = pad(32, "slopstream:prt:zero");
  sequence.increment(1);
  owner = disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>));
}

// Deployer/administrator secret key (dApp private state).
witness localSecretKey(): Bytes<32>;

// Brand's true cumulative spend in cents (dApp private state). NEVER disclosed.
witness actualSpendCents(): Uint<64>;

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "slopstream:pk:"), sequence, sk]);
}

// Owner-only: set the spend threshold that unlocks premium rights.
export circuit setSpendThreshold(newThreshold: Uint<64>): [] {
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Not the contract owner");
  spendThreshold = disclose(newThreshold);
  sequence.increment(1);
}

// Owner-only: record (or top up) the brand's spend commitment. The commitment
// binds the private spend value without revealing it.
export circuit recordSpend(spendCents: Uint<64>): [] {
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Not the contract owner");
  spendCommitment = disclose(persistentHash<Vector<2, Bytes<32>>>([pad(32, "slopstream:spend:"), spendCents as Field as Bytes<32>]));
  if (spendCents as Uint<64> >= spendThreshold) {
    qualified = true;
  }
  sequence.increment(1);
}

// Anyone can invoke: proves qualification against the committed spend using
// the private spend witness. Reveals ONLY the boolean — never the amount.
// Fails with "Spend below threshold" when the brand has not qualified.
export circuit proveQualification(): Boolean {
  assert(actualSpendCents() as Uint<64> >= spendThreshold, "Spend below threshold");
  assert(spendCommitment == persistentHash<Vector<2, Bytes<32>>>([pad(32, "slopstream:spend:"), actualSpendCents() as Field as Bytes<32>]), "Spend commitment mismatch");
  qualified = true;
  return disclose(true);
}
