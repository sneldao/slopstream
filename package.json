{
  "name": "slopstream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/midnight build && pnpm -r typecheck",
    "dev:web": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/web dev",
    "dev:api": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/api dev",
    "dev:orchestrator": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/orchestrator dev",
    "dev:generator": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/generator dev",
    "dev:verifier": "pnpm --filter @slopstream/shared build && pnpm --filter @slopstream/midnight build && pnpm --filter @slopstream/verifier dev"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@midnight-ntwrk/ledger-v8": "8.1.0"
    }
  }
}
